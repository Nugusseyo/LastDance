/* 타이틀 화면: 위쪽 가운데 제목, 아래쪽 가운데 버튼 3개. 뒤로는 3D 배경(도로·주유소)이 보인다. */

.title-root {
    flex-grow: 1;
    justify-content: space-between;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 100px;
    -unity-font-definition: url("project://database/Assets/_Works/JYG/Fonts/SUIT-Bold.ttf");
    opacity: 0;
    transition: opacity 1.2s ease-out;
}

/* TitleMenu가 시작 직후 붙여 서서히 나타나게 한다. */
.title-root--shown {
    opacity: 1;
}

.game-title {
    font-size: 160px;
    color: rgb(255, 210, 63);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(58, 31, 0);
    text-shadow: 6px 8px 0 rgba(0, 0, 0, 0.45);
    translate: 0 -60px;
    transition: translate 1.2s ease-out-back;
}

.title-root--shown .game-title {
    translate: 0 0;
}

.menu {
    width: 380px;
    align-items: stretch;
}

/* 설정 창이 떠 있는 동안 버튼을 숨긴다. */
.menu--hidden {
    display: none;
}

.menu-button {
    height: 72px;
    margin: 8px 0;
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgba(20, 20, 28, 0.75);
    border-width: 3px;
    border-color: rgb(255, 210, 63);
    border-radius: 14px;
    transition: background-color 0.15s, color 0.15s, scale 0.15s;
}

.menu-button:hover {
    background-color: rgb(255, 210, 63);
    color: rgb(42, 22, 0);
    scale: 1.06 1.06;
}

.menu-button:active {
    scale: 0.97 0.97;
}

.menu-button:disabled {
    opacity: 0.5;
}
