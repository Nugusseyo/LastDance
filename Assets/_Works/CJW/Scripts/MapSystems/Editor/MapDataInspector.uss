.map-root {
    padding: 6px 2px;
}

.map-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 6px;
    border-radius: 4px;
    background-color: rgba(127, 127, 127, 0.12);
}

.map-mode {
    -unity-font-style: bold;
}

.map-summary {
    opacity: 0.75;
}

.map-toolbar {
    flex-direction: row;
    margin-bottom: 4px;
}

.map-tool-button {
    margin-right: 4px;
}

.map-create-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.map-create-field {
    flex-grow: 1;
    margin-right: 4px;
}

.map-section {
    margin-bottom: 8px;
}

.map-section--issue {
    padding: 4px 6px;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgba(230, 120, 60, 0.9);
    background-color: rgba(230, 120, 60, 0.12);
}

.map-section-title {
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.map-issue {
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
}

.map-issue__text {
    flex-grow: 1;
    white-space: normal;
}

.map-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-radius: 3px;
}

.map-row:hover {
    background-color: rgba(127, 127, 127, 0.15);
}

.map-row__name {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.map-row__pos {
    opacity: 0.6;
    margin-right: 6px;
    -unity-font-style: italic;
}

.map-badge {
    padding: 0 6px;
    margin-right: 4px;
    border-radius: 8px;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.map-badge--free {
    background-color: rgba(70, 180, 110, 0.30);
}

.map-badge--busy {
    background-color: rgba(220, 90, 70, 0.30);
}

.map-empty {
    opacity: 0.5;
    -unity-font-style: italic;
    padding: 2px 4px;
}

.map-create-toggle {
    margin-right: 6px;
}
