.cd-root {
    flex-grow: 1;
    padding: 8px;
}

.cd-title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 6px;
}

.cd-scroll {
    flex-grow: 1;
}

/* 분할된 한 쪽. min-width가 있어야 가운데 선을 끝까지 밀어도 내용이 찌그러지지 않는다. */
.cd-pane {
    flex-grow: 1;
    min-width: 280px;
}

.cd-pane > .cd-scroll {
    padding-right: 4px;
}

/* 스크롤 밖에 고정되는 띠. 목록이 길어져도 만들기 버튼이 밀려나지 않는다. */
.cd-footer {
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.cd-section {
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 8px;
}

.cd-section__title {
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.cd-sub-title {
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 4px;
}

.cd-row {
    flex-direction: row;
    align-items: center;
}

.cd-grow {
    flex-grow: 1;
}

.cd-row__button {
    margin-left: 4px;
    min-width: 90px;
}

.cd-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    margin-top: 8px;
    margin-bottom: 8px;
}

.cd-help {
    white-space: normal;
    opacity: 0.6;
    font-size: 11px;
    margin-bottom: 2px;
}

.cd-issues {
    margin-top: 6px;
}

.cd-issue {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-radius: 3px;
    margin-bottom: 2px;
    white-space: normal;
}

.cd-issue--error {
    background-color: rgba(255, 80, 70, 0.18);
}

.cd-issue--warning {
    background-color: rgba(255, 190, 60, 0.16);
}

.cd-create {
    height: 26px;
    margin-top: 8px;
}

.cd-existing-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-radius: 3px;
}

.cd-existing-row:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.cd-existing-row__name {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cd-existing-row__meta {
    opacity: 0.6;
    font-size: 11px;
    margin-left: 6px;
}

.cd-badge {
    padding: 0 5px;
    border-radius: 3px;
    font-size: 10px;
    margin-left: 6px;
}

.cd-badge--missing {
    background-color: rgba(255, 80, 70, 0.28);
}

.cd-empty {
    opacity: 0.55;
    white-space: normal;
    padding: 4px 2px;
}
