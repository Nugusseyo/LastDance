  m_Script: {fileID: 11500000, guid: 40bd5ff9d61f2bd41b718da8f1380642, type: 3}
  m_Name: ReviewDB
  m_EditorClassIdentifier: Assembly-CSharp::Resources.DataBase.Review_Data.ReviewDB
  ReviewSheet:
  - index: 1
    type: 1
    contentUp: "\uC2E0\uC18D \uC815\uD655 \uACE0\uAE09\uC8FC\uC720\uC18C \uC644\uBCBD\uD558\uB2E4."
    contentDown: "\"\uC8FC\uC720\uD558\uB294 \uC190\uB2D8 \uB54C\uB9AC\uB294 \uBBF8\uCE5C
      \uC8FC\uC720\uC18C\uC784\""
    contentLate: "\uC9C0\uC5F0 \uC815\uD655 \uACE0\uAE09\uC8FC\uC720\uC18C..\uC2DC\uAC04
      \uC5C6\uB294\uB370 \uB108\uBB34 \uB290\uB9BC"
  - index: 2
    type: 2
    contentUp: "\uC0AC\uC7A5\uB2D8\uC774 \uB9DB\uC788\uACE0 \uAE30\uB984\uC774 \uCE5C\uC808\uD574\uC694"
    contentDown: "\"\uC2DC\uBE44\uAC70\uB294 \uC190\uB2D8\uC774 \uC788\uC5B4\uB3C4
      \uAD00\uB9AC \uD558\uB098\uB3C4 \uC548\uD558\uB294 \uC8FC\uC720\uC18C \""
    contentLate: 
  - index: 3
    type: 1
    contentUp: "\uC5EC\uAE30 \uAE30\uB984\uAC12\uC774 \uC606\uC9D1 \uCCA0\uC218\uB124\uBCF4\uB2E4
      \uC800\uB834\uD558\uB124\uC694!!"
    contentDown: "\"\uB300\uD654\uB3C4 \uBABB\uD558\uAC8C \uD558\uB294 \uC4F0\uB808\uAE30
      \uC8FC\uC720\uC18C!!\""
    contentLate: "\uAE30\uB984\uAC12\uC740 \uC2F8\uC9C0\uB9CC \uC190\uB2D8 \uC751\uB300\uAC00
      \uB108\uBB34 \uB290\uB824\uC694!!"
  - index: 4
    type: 2
    contentUp: "\uC190\uB2D8 \uC751\uB300 GOAT \uB9E4\uAC00 \uC57D\uC774\uB2E4"
    contentDown: "\"\uC0AC\uB78C\uB4E4\uC774 \uC2F8\uC6B0\uB294\uB370 \uBB34\uC12D\uACE0
      \uC0AC\uC7A5\uC740 \uB9D0\uB9AC\uC9C0\uB3C4 \uC54A\uC74C\""
    contentLate: 
  - index: 5
    type: 2
    contentUp: "\uC8FC\uC720\uC18C\uC5D0\uC11C \uAE30\uB984 \uB0C4\uC0C8\uAC00 \uB098\uC9C0\uB9CC
      \uCCAD\uACB0\uD569\uB2C8\uB2E4."
    contentDown: "\"\uC9C4\uC0C1 \uB300\uC751\uC774 \uB108\uBB34 \uC544\uC26C\uC6C0
      \uB108\uBB34 \uB2F5\uB2F5\uD569\uB2C8\uB2E4.\""
    contentLate: 
  - index: 6
    type: 2
    contentUp: "\uC5EC\uAE30.\uC8FC\uC720\uC18C\uAC00.\uCC38.\uC870\uC6A9\uD558\uB2C8.\uC88B\uB124\uC694.^^"
    contentDown: "\"\uC815\uC2E0\uBCD1\uC790. \uB0A0\uB6F0\uB294. \uCD5C\uC545\uC758.
      \uC8FC\uC720\uC18C...\""
    contentLate: "\uC5EC\uAE30\uB294. \uCC38\uAE30\uB984\uC73C\uB85C. \uAE30\uB984.
      \uCC44\uC6B0\uB098\u2026"
  - index: 7
    type: 2
    contentUp: "\uC870\uC6A9\uD558\uACE0 \uBD84\uC704\uAE30 \uC644\uC804 \uB290\uC88B
      \uC8FC\uC720\uC18C"
    contentDown: "\"\uB108\uBB34 \uC2DC\uB044\uB7FD\uACE0 \uBB34\uC11C\uC6CC\uC694..\uAD00\uB9AC\uB3C4
      \uC548\uD558\uB294 \uC8FC\uC720\uC18C\""
    contentLate: 
  - index: 8
    type: 1
    contentUp: "\uC790\uD310\uAE30 \uAC04\uC2DD \uC804\uBD80 \uB9DB@\uB3C4\uB9AC\uC784
      \uC548\uBA39\uC73C\uBA74 \uC778\uC0DD \uC190\uD574\uBD10\uC720"
    contentDown: "\"\uC790\uD310\uAE30 \uC774\uC6A9\uD558\uBA74 \uC0AC\uC7A5\uC774
      \uB54C\uB9AC\uB294 \uAC00\uAC8C \uAC00\uC9C0\uB9C8\uC720\""
    contentLate: "\uC190\uB2D8 \uC751\uB300\uAC00 \uB108\uBB34 \uB290\uB824\uC720..
      \uC790\uD310\uAE30\uB294 \uC88B\uC740\uB370..\uC544\uC26C\uC6CC\uC720"
  - index: 9
    type: 2
    contentUp: "9\uB9CC\uC6D0\uC5D0 \uAC00\uB4DD\uCC44\uC6E0\uC9C0\uB9CC \uB610\uAC00\uACE0
      \uC2F6\uC740 GGM\uC8FC\uC720\uC18C \uC785\uB2C8\uB2E4."
    contentDown: "\"\uBB34\uB8CC\uB85C UFC\uB97C \uBCFC \uC218 \uC788\uB294 \uCD5C\uC545\uC758
      \uC8FC\uC720\uC18C\""
    contentLate: 
  - index: 10
    type: 2
    contentUp: "G\u3154\u3141\uB9C8 T.\uBE0C@\uC774 \uC8FC#\uC720!\uC18C \uD3FC \uCA4C\uB124.
      \uAC80\uC0C9\uCC3D\uC5D0 \uAC80\uC0C9 \u3131\u3131"
    contentDown: "\"\uBB34\uB8CC\uB85C UFC\uB97C \uBCFC \uC218 \uC788\uB294 \uCD5C\uC545\uC758
      \uC8FC\uC720\uC18C\""
    contentLate: 
  - index: 11
    type: 2
    contentUp: "\uC5EC\uAE30 \uC644\uC804 \uAC1C\uAFC0\uC57C\uB974\uD55C \uC8FC\uC720\uC18C
      \uAF2D\uAC00\uC138\uC694"
    contentDown: "\"\uCDA4\uCD94\uAE30\uB9CC \uD574\uB3C4 \uBB50\uB77C\uD558\uB124\uC694
      \uC644\uC804 \uBC24\uD2F0\""
    contentLate: 
